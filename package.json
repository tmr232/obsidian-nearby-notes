{
	"name": "obsidian-nearby-notes",
	"version": "1.0.1",
	"private": true,
	"type": "module",
	"description": "Offline-first location capture and proximity browsing for Obsidian.",
	"license": "MIT",
	"packageManager": "bun@1.3.10",
	"scripts": {
		"dev": "bun esbuild.config.mjs",
		"build": "bun run typecheck && bun esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "oxlint --deny-warnings && biome check .",
		"format": "biome check --write .",
		"release:notes": "bun scripts/release-notes.ts",
		"check": "bun run lint && bun run build && bun run test && bun run release:notes"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@types/bun": "^1.3.0",
		"esbuild": "^0.25.0",
		"happy-dom": "^21.0.3",
		"obsidian": "^1.11.0",
		"obsidian-test-mocks": "^7.2.2",
		"oxlint": "^1.0.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
}
